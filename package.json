{
  "name": "texture-recreator",
  "version": "2.0.0",
  "description": "Free online seamless texture generator & 3D PBR material viewer with real-time Three.js lighting, 4-way mirror tiling, and instant export",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.{js,css,html}\""
  },
  "keywords": [
    "texture",
    "3d",
    "tiling",
    "seamless",
    "canvas",
    "image-processing"
  ],
  "author": "Akshay Nikhare",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "vite": "^7.3.6",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
